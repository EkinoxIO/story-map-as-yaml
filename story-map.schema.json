{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Story Map",
  "description": "A user story map: activities split into tasks, each holding stories sliced into releases.",
  "type": "object",
  "required": ["title", "releases", "activities"],
  "additionalProperties": false,
  "properties": {
    "title": { "$ref": "#/$defs/nonEmptyString" },
    "last_updated": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of the last edit."
    },
    "releases": {
      "type": "array",
      "description": "Releases in delivery order: the first one is delivered first.",
      "items": { "$ref": "#/$defs/release" }
    },
    "activities": {
      "type": "array",
      "description": "The backbone of the map, in user-journey order.",
      "items": { "$ref": "#/$defs/activity" }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "release": {
      "type": "object",
      "required": ["id", "title", "goal"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString",
          "description": "Referenced by the `release` field of stories."
        },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "goal": {
          "$ref": "#/$defs/nonEmptyString",
          "description": "The outcome this release is meant to achieve."
        }
      }
    },
    "activity": {
      "type": "object",
      "required": ["id", "title", "tasks"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^act_[0-9]+$" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "tasks": {
          "type": "array",
          "items": { "$ref": "#/$defs/task" }
        }
      }
    },
    "task": {
      "type": "object",
      "required": ["id", "title", "stories"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^task_[0-9]+$" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "stories": {
          "type": "array",
          "items": { "$ref": "#/$defs/story" }
        }
      }
    },
    "story": {
      "type": "object",
      "required": ["id", "title", "release", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^US-[0-9]+$" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "release": {
          "$ref": "#/$defs/nonEmptyString",
          "description": "Id of one of the releases listed under `releases`."
        },
        "status": {
          "enum": ["Backlog", "In Progress", "In Review", "Done"]
        }
      }
    }
  }
}
